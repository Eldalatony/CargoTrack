#!/bin/sh
# Conventional Commits enforcement (roadmap Phase 1: "enforced from day one").
# Zero-dependency — no husky, no commitlint, no node required.
#
# Enabled by: git config core.hooksPath .githooks
#
# Format:  type(optional-scope)!: subject
# Example: feat(orders): reject invalid status transitions with 422

msg_file="$1"
first_line=$(head -n 1 "$msg_file")

# Merge, revert and fixup commits bypass the check.
case "$first_line" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{1,}$'

if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "" >&2
  echo "  Commit message rejected — not a Conventional Commit." >&2
  echo "" >&2
  echo "  Got:      $first_line" >&2
  echo "  Expected: type(scope): subject" >&2
  echo "" >&2
  echo "  Types: feat fix docs style refactor perf test build ci chore revert" >&2
  echo "  Example: feat(containers): enforce CBM capacity guard on allocation" >&2
  echo "" >&2
  exit 1
fi

if [ "${#first_line}" -gt 100 ]; then
  echo "" >&2
  echo "  Commit subject is ${#first_line} characters (max 100)." >&2
  echo "" >&2
  exit 1
fi

exit 0

# CargoTrack — local development environment
#
# Copy to .env and adjust. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Production note: DATABASE_URL and REDIS_URL are the ONLY connection details
# the application reads. On Railway/VPS the platform injects them and the
# Compose DNS names below are never used. Application code does not change.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Postgres — consumed by the postgres container itself
# ---------------------------------------------------------------------------
POSTGRES_USER=cargotrack
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=cargotrack
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis — consumed by the redis container itself
# ---------------------------------------------------------------------------
REDIS_PASSWORD=change_me_redis
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Connection strings — the only DB/queue config the application sees.
# Hostnames "postgres" and "redis" are Compose service names and are correct
# ONLY for the local stack. Keep credentials in sync with the blocks above.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://cargotrack:change_me_postgres@postgres:5432/cargotrack?schema=public
REDIS_URL=redis://:change_me_redis@redis:6379

# Same databases as seen from the host (Prisma Studio, psql, GUI clients).
# DATABASE_URL_HOST=postgresql://cargotrack:change_me_postgres@localhost:5432/cargotrack?schema=public

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
BACKEND_PORT=4000
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000
FILE_STORAGE_PATH=/app/storage
# Runs the demo seed on container start. The seed skips itself when the
# database already holds data, so restarts never wipe your work.
SEED_ON_START=true

# ---------------------------------------------------------------------------
# Worker (BullMQ)
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=5
# Liveness port inside the worker container — not published to the host.
WORKER_HEALTH_PORT=4001

# ---------------------------------------------------------------------------
# Frontend
# NEXT_PUBLIC_* values are inlined into the browser bundle — this URL is
# resolved by the user's browser, so it must be localhost, not "backend".
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
